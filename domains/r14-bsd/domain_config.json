{
  "_doc": "DOMAIN VOCABULARY — the porting surface. The engine (index_vrs/ontology/coverage/query) is domain-agnostic; THIS file + the ontology seeds (canonical_objects, object_properties_seed, domain_links_seed, monitors_seed) encode the BSD/arboreal program. To run the audit tool on a different research program, replace this file and the seeds. index_vrs.py loads this if present, else falls back to its embedded defaults. {n} in a template = regex group n.",
  "entity_families": [
    {
      "pattern": "\\bVR-(\\d+)\\b",
      "template": "VR-{1}"
    },
    {
      "pattern": "\\bAUDIT-(\\d+)\\b",
      "template": "AUDIT-{1}"
    },
    {
      "pattern": "\\b(S[_₃₄₅₆]|A[_₃₄₅₆]|G[_₁₂₃₄₅₆ₖ]|D[_₄₆₈])\\b",
      "template": "{1}"
    },
    {
      "pattern": "\\b(S_\\d+|A_\\d+|G_\\d+|D_\\d+)\\b",
      "template": "{1}"
    },
    {
      "pattern": "\\b(cl\\d+|irr\\[\\d+\\]|irr_?\\d+)\\b",
      "template": "{1}"
    },
    {
      "pattern": "\\b(T\\d{1,2})\\b",
      "template": "{1}"
    },
    {
      "pattern": "\\b(eps_k\\d)\\s*=\\s*(\\d+)",
      "template": "{1}={2}"
    },
    {
      "pattern": "\\b(rank)\\s*=\\s*(\\d+)",
      "template": "rank={2}"
    },
    {
      "pattern": "\\|?[Ss]ha\\|?\\s*=\\s*(\\d+)",
      "template": "sha={1}"
    },
    {
      "pattern": "\\b(\\d+a\\d+)\\b",
      "template": "{1}"
    },
    {
      "pattern": "\\b(stem_\\d+|K[_₁₂₃₄₅₆])\\b",
      "template": "{1}"
    },
    {
      "pattern": "\\b(K_[A-Z]\\d+|K_[SD]\\d+|M_cubic)\\b",
      "template": "{1}"
    },
    {
      "pattern": "§(\\d+(?:\\.\\d+)*[a-z]?)",
      "template": "§{1}"
    },
    {
      "pattern": "\\b(proofs/\\w+(?:/\\w+)*\\.lean)\\b",
      "template": "{1}"
    },
    {
      "pattern": "\\b((?:scripts|lib)/[\\w/]+\\.(?:gp|py|g|c|gap|jl))\\b",
      "template": "{1}"
    },
    {
      "pattern": "(?<![\\w])Θ([₁₂])",
      "template": "Θ{1}"
    },
    {
      "pattern": "(?<![\\w])(Sel[₂2]|Sel\\^\\{?φ̂?\\}?|Sel\\^φ̂?|Sel\\^\\{?phi\\}?)",
      "template": "{1}"
    },
    {
      "pattern": "(?<![\\w])(E['′](?:\\^?\\{?[-−]?\\d+\\}?)?)",
      "template": "{1}"
    },
    {
      "pattern": "(?<![\\w])(C_Θ)",
      "template": "{1}"
    }
  ],
  "supersession_patterns": [
    {
      "pattern": "\\[CORRECTED\\s+(?:by\\s+)?VR-(\\d+)\\]",
      "relation": "corrected_by"
    },
    {
      "pattern": "\\[CORRECTED\\s+(?:by\\s+)?AUDIT-(\\d+)\\]",
      "relation": "corrected_by_audit"
    },
    {
      "pattern": "\\[DEPRECATED(?:\\s+(?:as of\\s+)?(?:v[\\d.]+|VR-(\\d+)))?\\]",
      "relation": "deprecated"
    },
    {
      "pattern": "\\[RETRACTED(?:\\s+(?:by\\s+)?VR-(\\d+))?\\]",
      "relation": "retracted"
    },
    {
      "pattern": "\\[SUPERSEDED\\s+(?:by\\s+)?VR-(\\d+)\\]",
      "relation": "superseded_by"
    },
    {
      "pattern": "\\[AFFECTED\\s+(?:by\\s+)?VR-(\\d+)\\]",
      "relation": "affected_by"
    },
    {
      "pattern": "\\bcorrects?\\s+VR-(\\d+)\\b",
      "relation": "corrects"
    },
    {
      "pattern": "\\bsupersedes?\\s+VR-(\\d+)\\b",
      "relation": "supersedes"
    },
    {
      "pattern": "\\badvances?\\s+VR-(\\d+)\\b",
      "relation": "supersedes"
    },
    {
      "pattern": "\\bretract(?:s|ed)\\s+VR-(\\d+)\\b",
      "relation": "retracts"
    },
    {
      "pattern": "\\bfrom\\s+VR-(\\d+)\\b",
      "relation": "references"
    },
    {
      "pattern": "\\bper\\s+VR-(\\d+)\\b",
      "relation": "references"
    },
    {
      "pattern": "\\bVR-(\\d+)\\s+(?:period\\s+)?correction\\b",
      "relation": "correction_of"
    },
    {
      "pattern": "\\bmissing\\s+from\\s+VR-(\\d+)",
      "relation": "correction_of"
    },
    {
      "pattern": "\\bVR-(\\d+)\\+?\\s+scripts?\\b",
      "relation": "script_ref"
    },
    {
      "pattern": "\\brefutes?\\s+VR-(\\d+)\\b",
      "relation": "refutes"
    },
    {
      "pattern": "\\bfalsif(?:y|ies|ied)\\s+VR-(\\d+)\\b",
      "relation": "refutes"
    },
    {
      "pattern": "\\bcontradicts?\\s+VR-(\\d+)\\b",
      "relation": "refutes"
    },
    {
      "pattern": "\\boverturns?\\s+VR-(\\d+)\\b",
      "relation": "refutes"
    },
    {
      "pattern": "\\bVR-(\\d+)(?:'s|s)?\\s+(?:claim|thesis|conclusion)?\\s*(?:is\\s+)?(?:REFUTED|FALSIFIED|RETRACTED|WRONG|DEAD)",
      "relation": "refutes"
    },
    {
      "pattern": "\\bREOPEN(?:S|ED)\\s+VR-(\\d+)\\b",
      "relation": "reopens"
    },
    {
      "pattern": "\\bVR-(\\d+)\\s+(?:REOPENED|reopened)\\b",
      "relation": "reopens"
    },
    {
      "pattern": "\\bamend(?:s|ed|ing)?\\s+VR-(\\d+)\\b",
      "relation": "amends"
    },
    {
      "pattern": "\\bresolves?\\s+(?:the\\s+)?(?:open\\s+)?(?:ask\\s+)?(?:in\\s+)?VR-(\\d+)\\b",
      "relation": "corrects"
    },
    {
      "pattern": "\\bcorrecting\\s+VR-(\\d+)\\b",
      "relation": "corrects"
    },
    {
      "pattern": "\\bdowngrade(?:s|d)?\\s+VR-(\\d+)\\b",
      "relation": "downgrades"
    },
    {
      "pattern": "\\bVR-(\\d+)(?:/\\d+)*(?:'s|s)?\\s+[^.]{0,80}?\\bDOWNGRADED\\b",
      "relation": "downgrades"
    },
    {
      "pattern": "\\bsoftens?\\s+VR-(\\d+)\\b",
      "relation": "downgrades"
    },
    {
      "pattern": "\\[SOFTENED\\s+(?:by\\s+)?VR-(\\d+)\\]",
      "relation": "corrected_by"
    },
    {
      "pattern": "\\b(?:re-?)?confirms\\s+VR-(\\d+)\\b",
      "relation": "corroborates"
    },
    {
      "pattern": "\\breproduces\\s+VR-(\\d+)\\b",
      "relation": "corroborates"
    },
    {
      "pattern": "\\bmatches\\s+VR-(\\d+)\\b",
      "relation": "corroborates"
    },
    {
      "pattern": "\\bvalidates\\s+VR-(\\d+)\\b",
      "relation": "corroborates"
    },
    {
      "pattern": "\\bcloses\\s+VR-(\\d+)\\b",
      "relation": "closes"
    },
    {
      "pattern": "\\bcloses\\s+AUDIT-(\\d+)\\b",
      "relation": "closes_audit"
    }
  ],
  "reference_relations": [
    "closes",
    "closes_audit",
    "corroborates",
    "references",
    "script_ref"
  ],
  "correction_relations": [
    "amends",
    "corrected_by",
    "corrected_by_audit",
    "correction_of",
    "corrects",
    "downgrades",
    "refutes",
    "retracts",
    "supersedes"
  ],
  "quantities": [
    {
      "name": "eps_k",
      "value_pattern": "(eps_k\\d)=(\\d+)",
      "key_group": 1,
      "key_literal": null,
      "val_group": 2,
      "bound": null
    },
    {
      "name": "rank",
      "value_pattern": "\\brank[ =-](\\d+)",
      "key_group": null,
      "key_literal": "rank",
      "val_group": 1,
      "bound": [
        0,
        9
      ]
    },
    {
      "name": "sha",
      "value_pattern": "sha=(\\d+)",
      "key_group": null,
      "key_literal": "sha",
      "val_group": 1,
      "bound": [
        1,
        4096
      ]
    },
    {
      "name": "val2",
      "value_pattern": "(?:val₂|v₂)(?:-subrank)?\\s*=\\s*(-?\\d+)",
      "key_group": null,
      "key_literal": "val2",
      "val_group": 1,
      "bound": [
        -32,
        32
      ]
    }
  ],
  "type_schema": {
    "vr_ref": {
      "display": "VR cross-reference",
      "match": "VR-\\d+",
      "valid": "VR-\\d+"
    },
    "audit_ref": {
      "display": "AUDIT cross-reference",
      "match": "AUDIT-\\d+",
      "valid": "AUDIT-\\d+"
    },
    "parameter": {
      "display": "tracked quantity/value",
      "match": "(?:rank|sha|eps_k\\d|val2)(?:=-?\\d+)?",
      "valid": "(?:rank|sha|eps_k\\d|val2)(?:=-?\\d+)?"
    },
    "theorem": {
      "display": "theorem label",
      "match": "T\\d{1,2}",
      "valid": "T\\d{1,2}"
    },
    "irrep_class": {
      "display": "conjugacy class / irrep",
      "match": "cl\\d+|irr\\[?_?\\d+\\]?",
      "valid": "cl\\d+|irr\\[\\d+\\]|irr_?\\d+"
    },
    "field": {
      "display": "number field",
      "match": "stem_\\d+|K[_₁₂₃₄₅₆]|K_[A-Z]\\d+|K_[SD]\\d+|M_cubic",
      "valid": "stem_\\d+|K[₁₂₃₄₅₆]|K_[A-Z]\\d+|K_[SD]\\d+|M_cubic"
    },
    "curve": {
      "display": "elliptic curve (Cremona)",
      "match": "\\d+a\\d+",
      "valid": "\\d{1,4}a\\d{1,2}"
    },
    "group": {
      "display": "Galois/symmetry group",
      "match": "[SAGD](?:_\\d*|[₀₁₂₃₄₅₆₇₈₉ₖ])",
      "valid": "[SAGD](?:_\\d+|[₀₁₂₃₄₅₆₇₈₉ₖ])"
    },
    "section": {
      "display": "paper section",
      "match": "§\\d+(?:\\.\\d+)*[a-z]?",
      "valid": "§\\d+(?:\\.\\d+)*[a-z]?"
    },
    "lean_module": {
      "display": "Lean module",
      "match": "proofs/[\\w/]+\\.lean",
      "valid": "proofs/[\\w/]+\\.lean"
    },
    "script": {
      "display": "compute script",
      "match": "(?:scripts|lib)/[\\w/]+\\.(?:gp|py|g|c|gap|jl)",
      "valid": "(?:scripts|lib)/[\\w/]+\\.(?:gp|py|g|c|gap|jl)"
    },
    "descent_map": {
      "display": "8-descent map (Theta)",
      "match": "Θ[₁₂]",
      "valid": "Θ[₁₂]"
    },
    "selmer": {
      "display": "Selmer group",
      "match": "Sel.*",
      "valid": "Sel.*"
    },
    "control_curve": {
      "display": "descent control curve (E-prime)",
      "match": "E['′].*",
      "valid": "E['′].*"
    },
    "named_constant": {
      "display": "named constant",
      "match": "C_Θ",
      "valid": "C_Θ"
    }
  }
}